    <comp lib="7" loc="(1310,565)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="REG_DST: 00 = rt  01 = rd  10 = $ra (11111)"/>
    </comp>
    <comp lib="7" loc="(1310,785)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="WB_SEL: 00 = ALU_OUT  01 = memory  10 = PC (jal)"/>
    </comp>
    <comp lib="7" loc="(1315,205)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_RD: 0 = rs  1 = $v0 (00010)"/>
    </comp>
    <comp lib="7" loc="(1315,385)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_RD: 0 = rt  1 = $a0 (00100)"/>
    </comp>
    <comp lib="7" loc="(1320,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Reads rs and rt in DECODE and stores them in A and B (AB_WRITE)."/>
    </comp>
    <comp lib="7" loc="(1320,1005)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Register_File"/>
    </comp>
    <comp lib="7" loc="(1320,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="In syscall (SYS_RD = 1) reads $v0 (00010) and $a0 (00100)."/>
    </comp>
    <comp lib="7" loc="(1320,1285)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="A = R[rs]  (or $v0 in syscall)"/>
    </comp>
    <comp lib="7" loc="(1320,135)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Writes on the rising edge if REG_WRITE = 1."/>
    </comp>
    <comp lib="7" loc="(1320,1495)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="B = R[rt]  (or $a0 in syscall)"/>
    </comp>
    <comp lib="7" loc="(1320,80)" name="Text">
      <a name="text" val="2. REGISTER FILE"/>
    </comp>
    <comp lib="7" loc="(190,80)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Control signals (from Control_Unit and Branch_Control)"/>
    </comp>
    <comp lib="7" loc="(1910,1025)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SHAMT_32 = ZeroExt(shamt)"/>
    </comp>
    <comp lib="7" loc="(1915,565)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXT_MODE (from Instruction_Decoder): 01 = sign-extended  10 = zero-extended  11 = lui"/>
    </comp>
    <comp lib="7" loc="(1915,775)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMM_X4_18 = {IMM, 00}"/>
    </comp>
    <comp lib="7" loc="(1915,905)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMM_X4 = SignExt(IMM) x 4  (branches)"/>
    </comp>
    <comp lib="7" loc="(1920,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Immediate: sign-extended (addi, addiu, slti, memory, branches),"/>
    </comp>
    <comp lib="7" loc="(1920,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="zero-extended (andi, ori) or shifted by 16 (lui)."/>
    </comp>
    <comp lib="7" loc="(1920,135)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="EXT_MODE comes from Instruction_Decoder."/>
    </comp>
    <comp lib="7" loc="(1920,195)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMM_SIGN = SignExt(IMM)"/>
    </comp>
    <comp lib="7" loc="(1920,315)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMM_ZERO = ZeroExt(IMM)"/>
    </comp>
    <comp lib="7" loc="(1920,435)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IMM_LUI = {IMM, 16 zeros}"/>
    </comp>
    <comp lib="7" loc="(1920,80)" name="Text">
      <a name="text" val="3. IMMEDIATE AND SHAMT"/>
    </comp>
    <comp lib="7" loc="(205,55)" name="Text">
      <a name="text" val="INPUTS"/>
    </comp>
    <comp lib="7" loc="(2515,205)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALU_SRC_A: 00 = PC  01 = A  10 = shamt"/>
    </comp>
    <comp lib="7" loc="(2515,425)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALU_SRC_B: 00 = B  01 = 4  10 = immediate  11 = immediate x 4"/>
    </comp>
    <comp lib="7" loc="(2520,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="The ALU shifts B by the amount A[4:0]:"/>
    </comp>
    <comp lib="7" loc="(2520,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="in sll and srl, A = shamt and B = R[rt]."/>
    </comp>
    <comp lib="7" loc="(2520,135)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ZERO = 1 if A - B = 0 (beq, bne)."/>
    </comp>
    <comp lib="7" loc="(2520,80)" name="Text">
      <a name="text" val="4. ALU"/>
    </comp>
    <comp lib="7" loc="(2560,820)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ALU_OUT"/>
    </comp>
    <comp lib="7" loc="(3110,195)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_SEL = ALU_OUT[1:0]"/>
    </comp>
    <comp lib="7" loc="(3110,315)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_RDATA bytes"/>
    </comp>
    <comp lib="7" loc="(3115,715)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_SIGN = SignExt(byte)  (lb)"/>
    </comp>
    <comp lib="7" loc="(3115,835)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_ZERO = ZeroExt(byte)  (lbu)"/>
    </comp>
    <comp lib="7" loc="(3120,505)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_SEL: selects the byte read"/>
    </comp>
    <comp lib="7" loc="(3290,105)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Little-endian: byte k of the word is in bits 8k+7..8k."/>
    </comp>
    <comp lib="7" loc="(3290,125)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_SEL = ALU_OUT[1:0] selects the byte."/>
    </comp>
    <comp lib="7" loc="(3290,140)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_WE comes directly from Control_Unit."/>
    </comp>
    <comp lib="7" loc="(3290,85)" name="Text">
      <a name="text" val="5. MEMORY: LB, LBU AND SB"/>
    </comp>
    <comp lib="7" loc="(3480,1235)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_BYTE: 0 = 1111 (sw)  1 = one byte (sb)"/>
    </comp>
    <comp lib="7" loc="(3480,195)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="LB_SIGN: 0 = lbu  1 = lb"/>
    </comp>
    <comp lib="7" loc="(3480,545)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="B_BYTE = B[7:0]"/>
    </comp>
    <comp lib="7" loc="(3485,1025)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="BYTE_SEL: 0001, 0010, 0100, 1000"/>
    </comp>
    <comp lib="7" loc="(3485,375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_BYTE: 0 = word (lw)  1 = byte (lb, lbu)"/>
    </comp>
    <comp lib="7" loc="(3485,665)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="B_BYTE_X4: the byte on all 4 lanes"/>
    </comp>
    <comp lib="7" loc="(3485,855)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="MEM_BYTE: 0 = sw (B)  1 = sb (repeated byte)"/>
    </comp>
    <comp lib="7" loc="(3870,375)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_PRINT = (A == 1011)"/>
    </comp>
    <comp lib="7" loc="(3870,505)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="TTY_DATA = B[6:0]"/>
    </comp>
    <comp lib="7" loc="(3875,245)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_EXIT = (A == 1010)"/>
    </comp>
    <comp lib="7" loc="(3890,130)" name="Text">
      <a name="text" val="6. SYSCALL"/>
    </comp>
    <comp lib="7" loc="(3890,150)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="In syscall, A = $v0 and B = $a0."/>
    </comp>
    <comp lib="7" loc="(3890,170)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="SYS_EXIT: $v0 = 1010 (10)   SYS_PRINT: $v0 = 1011 (11)"/>
    </comp>
    <comp lib="7" loc="(3890,185)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="TTY_DATA = $a0[6:0]"/>
    </comp>
    <comp lib="7" loc="(4085,70)" name="Text">
      <a name="text" val="OUTPUTS"/>
    </comp>
    <comp lib="7" loc="(4270,130)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="To the CPU, memory and the decoder"/>
    </comp>
    <comp lib="7" loc="(710,625)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="IR: written in FETCH (IR_WRITE = 1)"/>
    </comp>
    <comp lib="7" loc="(715,1415)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="ADDR_SEL: 0 = PC (FETCH)  1 = ALU_OUT (lw, sw, lb, lbu, sb)"/>
    </comp>
    <comp lib="7" loc="(715,205)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC_SRC: 00 = ALU (PC+4)  01 = ALU_OUT (branch)  10 = j/jal  11 = A (jr)"/>
    </comp>
    <comp lib="7" loc="(715,845)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Instruction fields"/>
    </comp>
    <comp lib="7" loc="(720,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="The PC holds the address of the current instruction;"/>
    </comp>
    <comp lib="7" loc="(720,1155)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC_TOP4 = PC[31:28]"/>
    </comp>
    <comp lib="7" loc="(720,120)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="the IR holds the instruction read in FETCH ([R13])."/>
    </comp>
    <comp lib="7" loc="(720,1255)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="JUMP_ADDR = {PC[31:28], TARGET, 00}  (the PC already holds PC+4)"/>
    </comp>
    <comp lib="7" loc="(720,135)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC + 4 and the jump targets are computed by the ALU ([R14])."/>
    </comp>
    <comp lib="7" loc="(720,425)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="PC: written if PC_EN = 1 (output of Branch_Control)"/>
    </comp>
    <comp lib="7" loc="(720,80)" name="Text">
      <a name="text" val="1. PC AND IR"/>
    </comp>
