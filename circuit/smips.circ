    <comp lib="7" loc="(1670,710)" name="Text">
      <a name="text" val="STATE REGISTER (one-hot)"/>
    </comp>
    <comp lib="7" loc="(1670,730)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="FETCH -&gt; DECODE -&gt; {EXEC-&gt;ALU_WB | MEM_ADDR-&gt;LOAD/STORE | BR_TGT-&gt;BR_CMP | JUMP | JR | SYSCALL-&gt;PRINT/HALT} -&gt; FETCH ; ILLEGAL -&gt; HALT"/>
    </comp>
    <comp lib="7" loc="(1675,55)" name="Text">
      <a name="text" val="CLASS GROUPS"/>
    </comp>
    <comp lib="7" loc="(2125,1525)" name="Text">
      <a name="text" val="CONTROL OUTPUTS"/>
    </comp>
    <comp lib="7" loc="(255,430)" name="Text">
      <a name="text" val="INVERTERS"/>
    </comp>
    <comp lib="7" loc="(270,970)" name="Text">
      <a name="text" val="CLASS DECODING (5 bits) -&gt; one line per class"/>
    </comp>
    <comp lib="7" loc="(2725,735)" name="Text">
      <a name="text" val="NEXT-STATE LOGIC"/>
    </comp>
    <comp lib="7" loc="(360,110)" name="Text">
      <a name="text" val="INPUTS"/>
    </comp>
    <comp lib="7" loc="(3740,765)" name="Text">
      <a name="text" val="OUTPUT PINS"/>
    </comp>
    <comp lib="7" loc="(400,140)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS/ALU_OP come from the Instruction_Decoder; SYS_EXIT=($v0==10) and SYS_PRINT=($v0==11) are computed by the Datapath from register A."/>
    </comp>
    <comp lib="7" loc="(595,1005)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="CLASS = 00000 R | 00001 addi/addiu | 00010 slti | 00011 andi | 00100 ori | 00101 lui | 00110 lw | 00111 sw | 01000 lb | 01001 lbu | 01010 sb | 01011 beq | 01100 bne | 01101 j | 01110 jal | 01111 jr | 10000 syscall"/>
    </comp>
    <comp lib="7" loc="(685,40)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Control_Unit: one-hot state machine (Moore/Mealy), 14 states"/>
    </comp>
    <comp lib="7" loc="(695,65)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Asynchronous reset: all flip-flops set to 0 =&gt; FETCH state (nS_FETCH = NOT S_FETCH is stored). Logic uses only 2-input gates and tunnels."/>
    </comp>
