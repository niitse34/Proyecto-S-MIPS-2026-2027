    <comp lib="7" loc="(150,1260)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$gp write: D = rd XOR 0x1800"/>
    </comp>
    <comp lib="7" loc="(150,1560)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$sp write: D = rd XOR 0x3FFC"/>
    </comp>
    <comp lib="7" loc="(600,1200)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$gp (x28) and $sp (x29) reset to 0x1800 and 0x3FFC ([R6]): the physical register stores (value XOR initial) and its asynchronous clear (reset) sets it to 0, so reading with XOR gives back the initial value."/>
    </comp>
    <comp lib="7" loc="(640,100)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="$zero: constant 0 (no register): reading x0 gives 0 and writing it has no effect"/>
    </comp>
    <comp lib="7" loc="(650,1260)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$gp read: Q = reg XOR 0x1800"/>
    </comp>
    <comp lib="7" loc="(650,1560)" name="Text">
      <a name="font" val="SansSerif bold 12"/>
      <a name="text" val="$sp read: Q = reg XOR 0x3FFC"/>
    </comp>
